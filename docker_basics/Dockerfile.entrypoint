FROM python:3.12-slim
# `docker run <image> --port 9000` replaces the default port arguments, while
# `docker run <image> python --version` cannot replace the fixed ENTRYPOINT.
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENTRYPOINT ["uvicorn", "main:app", "--host", "0.0.0.0"]
CMD ["--port", "8000"]
